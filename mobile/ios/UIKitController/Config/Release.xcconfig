// Optional per-machine signing settings (DEVELOPMENT_TEAM). The file is git-ignored.
#include? "../../Config/Local.xcconfig"
#include "Base.xcconfig"

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
