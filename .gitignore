# Theos / build artifacts
.theos/
*.deb
packages/
obj/
core/*/.stamp
.DS_Store

# Native mobile build/user state
mobile/**/.build/
mobile/**/.swiftpm/
mobile/**/DerivedData/
mobile/**/.derivedData*/
mobile/**/xcuserdata/
mobile/**/*.xcuserstate
mobile/android/.gradle/
mobile/android/**/build/
mobile/android/local.properties
protocol/node_modules/

# Debug captures (may contain the device's screen — never commit)
*.png
*.h264
*.bin
.playwright-mcp/

# Secrets / keys — never commit
.env
.env.*
!.env.example
relay.env
*.secret
*.token
*.pem
*_ed25519
*_ed25519.pub
*.p12
*.mobileprovision

# Per-user relay packaging output may embed private relay enrollment tokens.
personalized/
relay-config.plist
relay/.env
relay/data/
relay/rctl-relay
