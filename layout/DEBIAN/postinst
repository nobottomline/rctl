#!/bin/sh
# Re-sign our binaries with the device's own ldid — ad-hoc signatures made
# off-device (macOS) are rejected by on-device AMFI on arm64e, so the dylib is
# refused at load and the daemon is SIGKILLed. Then (re)load the daemon and
# respring so SpringBoard picks up the agent.
set -e

DYLIB=/Library/MobileSubstrate/DynamicLibraries/rctlsbcap.dylib
MSDLIB=/Library/MobileSubstrate/DynamicLibraries/rctlmsd.dylib
CAPLIB=/Library/MobileSubstrate/DynamicLibraries/rctlcap.dylib
DAEMON=/usr/local/bin/rctld
CAM=/usr/local/bin/rctlcam
PLIST=/Library/LaunchDaemons/com.greatlove.rctld.plist

CAMENT=/usr/local/share/rctl/cam-ent.plist

if command -v ldid >/dev/null 2>&1; then
    [ -f "$DYLIB" ]   && ldid -S "$DYLIB"   || true
    [ -f "$MSDLIB" ]  && ldid -S "$MSDLIB"  || true
    [ -f "$CAPLIB" ]  && ldid -S "$CAPLIB"  || true
    [ -f "$DAEMON" ]  && ldid -S "$DAEMON"  || true
    # Sign the camera helper WITH the TCC-allow entitlement (camera service).
    if [ -f "$CAM" ]; then
        if [ -f "$CAMENT" ]; then ldid -S"$CAMENT" "$CAM" || ldid -S "$CAM" || true
        else ldid -S "$CAM" || true; fi
    fi
fi

# (Re)load the launchd daemon.
if [ -f "$PLIST" ]; then
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"   2>/dev/null || true
fi

# Grant the camera TCC service to every installed app so the in-app capture
# (rctlcap, runs in the FRONTMOST app) works anywhere. mediaserverd checks TCC
# server-side by audit token, so the grant must be a real access-table row.
TCCDB=/var/mobile/Library/TCC/TCC.db
if [ -f "$TCCDB" ] && command -v sqlite3 >/dev/null 2>&1; then
    set +e
    for plist in /Applications/*/Info.plist /var/containers/Bundle/Application/*/*.app/Info.plist; do
        [ -f "$plist" ] || continue
        bid=$(plutil -key CFBundleIdentifier "$plist" 2>/dev/null)
        [ -n "$bid" ] && sqlite3 "$TCCDB" "INSERT OR REPLACE INTO access (service,client,client_type,auth_value,auth_reason,auth_version,indirect_object_identifier,flags) VALUES ('kTCCServiceCamera','$bid',0,2,2,1,'UNUSED',0);" 2>/dev/null
    done
    killall tccd 2>/dev/null
    set -e
fi

# Respring so SpringBoard picks up the (re)installed agent.
killall -9 SpringBoard 2>/dev/null || true

exit 0
