#!/bin/sh
# Re-sign our binaries with the device's own ldid — ad-hoc signatures made
# off-device (macOS) are rejected by on-device AMFI on arm64e, so the dylib is
# refused at load and the daemon is SIGKILLed. Then (re)load the daemon and
# respring so SpringBoard picks up the agent.
set -e

DYLIB=/Library/MobileSubstrate/DynamicLibraries/rctlsbcap.dylib
CAPLIB=/Library/MobileSubstrate/DynamicLibraries/rctlcap.dylib
DAEMON=/usr/local/bin/rctld
PLIST=/Library/LaunchDaemons/com.greatlove.rctld.plist

if command -v ldid >/dev/null 2>&1; then
    [ -f "$DYLIB" ]   && ldid -S "$DYLIB"   || true
    [ -f "$CAPLIB" ]  && ldid -S "$CAPLIB"  || true
    [ -f "$DAEMON" ]  && ldid -S "$DAEMON"  || true
fi

# (Re)load the launchd daemon.
if [ -f "$PLIST" ]; then
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"   2>/dev/null || true
fi

# Do not enumerate every installed app here. That TCC grant path is expensive and
# can leave dpkg stuck in postinst, which is unacceptable during recovery deploys.
# Camera permissions are managed explicitly by the camera workflow instead.

# Respring so SpringBoard picks up the (re)installed agent.
killall -9 SpringBoard 2>/dev/null || true

exit 0
