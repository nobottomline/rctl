#!/bin/sh
# Re-sign our binaries with the device's own ldid — ad-hoc signatures made
# off-device (macOS) are rejected by on-device AMFI on arm64e, so the dylib is
# refused at load and the daemon is SIGKILLed. Then (re)load the daemon and
# respring so SpringBoard picks up the agent.
set -e

DYLIB=/Library/MobileSubstrate/DynamicLibraries/rctlsbcap.dylib
CAPLIB=/Library/MobileSubstrate/DynamicLibraries/rctlcap.dylib
DAEMON=/usr/local/bin/rctld
PLIST=/Library/LaunchDaemons/com.greatlove.rctld.plist
AUDIOSRC=/usr/local/lib/rctl/audio/rctlaudio.dylib
LEGACY_AUDIOSRC=/usr/local/lib/rctl/audio/rctlaudiosource.dylib
LEGACY_AUDIOPLIST=/usr/local/lib/rctl/audio/rctlaudiosource.plist
AUDIO_ACTIVE_DYLIB=/Library/MobileSubstrate/DynamicLibraries/rctlaudio.dylib
AUDIO_ACTIVE_PLIST=/Library/MobileSubstrate/DynamicLibraries/rctlaudio.plist
AUDIO_CAPTURE_MARKER=/tmp/rctl-audio-capture
AUDIO_TONE_MARKER=/tmp/rctl-audio-tone
LEGACY_AUDIO_ACTIVE_DYLIB=/Library/MobileSubstrate/DynamicLibraries/rctlaudiosource.dylib
LEGACY_AUDIO_ACTIVE_PLIST=/Library/MobileSubstrate/DynamicLibraries/rctlaudiosource.plist
LEGACY_AUDIO_CAPTURE_MARKER=/tmp/rctl-audiosource-capture
LEGACY_AUDIO_TONE_MARKER=/tmp/rctl-audiosource-tone
RELAY_PREF=/var/mobile/Library/Preferences/com.greatlove.rctl.relay.plist
RELAY_PREF_BACKUP=/tmp/com.greatlove.rctl.relay.plist.rctl-preserve

if command -v ldid >/dev/null 2>&1; then
    [ -f "$DYLIB" ]   && ldid -S "$DYLIB"   || true
    [ -f "$CAPLIB" ]  && ldid -S "$CAPLIB"  || true
    [ -f "$DAEMON" ]  && ldid -S "$DAEMON"  || true
    [ -f "$AUDIOSRC" ] && ldid -S "$AUDIOSRC" || true
fi

# dpkg packages built on macOS can preserve the builder's uid/gid. launchd is
# strict about daemon plists, so normalize ownership on-device before loading.
chown root:wheel "$PLIST" "$DAEMON" 2>/dev/null || chown root:0 "$PLIST" "$DAEMON" 2>/dev/null || true
chmod 0644 "$PLIST" 2>/dev/null || true
chmod 0755 "$DAEMON" 2>/dev/null || true

# Personalized relay packages contain an enrollment token, but an already paired
# device has a stronger persistent DeviceSecret. Preserve that secret across
# remove+fresh-install deploys so reinstalling the tweak does not create a new
# pending device or reuse an expired enrollment token.
if [ -f "$RELAY_PREF_BACKUP" ] && grep -aq "DeviceSecret" "$RELAY_PREF_BACKUP"; then
    if [ ! -f "$RELAY_PREF" ] || ! grep -aq "DeviceSecret" "$RELAY_PREF"; then
        cp "$RELAY_PREF_BACKUP" "$RELAY_PREF" 2>/dev/null || true
    fi
fi
if [ -f "$RELAY_PREF" ]; then
    chown mobile:mobile "$RELAY_PREF" 2>/dev/null || chown mobile:501 "$RELAY_PREF" 2>/dev/null || true
    chmod 0600 "$RELAY_PREF" 2>/dev/null || true
fi

# Audio capture is opt-in. Never leave an active mediaserverd injection across
# package installs/upgrades; only the inactive payload under /usr/local/lib ships.
audio_was_active=0
[ -e "$AUDIO_ACTIVE_DYLIB" ] && audio_was_active=1
[ -e "$AUDIO_ACTIVE_PLIST" ] && audio_was_active=1
[ -e "$AUDIO_CAPTURE_MARKER" ] && audio_was_active=1
[ -e "$AUDIO_TONE_MARKER" ] && audio_was_active=1
[ -e "$LEGACY_AUDIO_ACTIVE_DYLIB" ] && audio_was_active=1
[ -e "$LEGACY_AUDIO_ACTIVE_PLIST" ] && audio_was_active=1
[ -e "$LEGACY_AUDIO_CAPTURE_MARKER" ] && audio_was_active=1
[ -e "$LEGACY_AUDIO_TONE_MARKER" ] && audio_was_active=1
rm -f "$AUDIO_ACTIVE_DYLIB" "$AUDIO_ACTIVE_PLIST" "$AUDIO_CAPTURE_MARKER" "$AUDIO_TONE_MARKER" \
      "$LEGACY_AUDIO_ACTIVE_DYLIB" "$LEGACY_AUDIO_ACTIVE_PLIST" \
      "$LEGACY_AUDIO_CAPTURE_MARKER" "$LEGACY_AUDIO_TONE_MARKER" \
      "$LEGACY_AUDIOSRC" "$LEGACY_AUDIOPLIST"
[ "$audio_was_active" = "1" ] && killall mediaserverd 2>/dev/null || true

# (Re)load the launchd daemon.
if [ -f "$PLIST" ]; then
    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"   2>/dev/null || true
fi

# Do not enumerate every installed app here. That TCC grant path is expensive and
# can leave dpkg stuck in postinst, which is unacceptable during recovery deploys.
# Camera permissions are managed explicitly by the camera workflow instead.

# Respring so SpringBoard picks up the (re)installed agent.
killall -9 SpringBoard 2>/dev/null || true

exit 0
