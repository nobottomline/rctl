<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.greatlove.rctld</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/rctld</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>3</integer>
	<key>StandardOutPath</key>
	<string>/tmp/rctld.out.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/rctld.err.log</string>
</dict>
</plist>
