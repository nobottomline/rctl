# Example Nginx server block for rctl relay.
# Replace rctl.example.com and certificate paths.
# The relay container should stay bound to 127.0.0.1:8080 via compose.yaml.
#
# In relay/.env, set:
#   RCTL_RELAY_PUBLIC_URL=https://rctl.example.com
#   RCTL_RELAY_TRUST_PROXY_HEADERS=1

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=rctl_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=rctl_admin:10m rate=60r/m;

server {
    listen 80;
    listen [::]:80;
    server_name rctl.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rctl.example.com;

    ssl_certificate /etc/letsencrypt/live/rctl.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rctl.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /api/admin/login {
        limit_req zone=rctl_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include rctl_proxy_params;
    }

    location /api/admin/ {
        limit_req zone=rctl_admin burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include rctl_proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include rctl_proxy_params;
    }
}
