[Unit]
Description=rctl relay dedicated nginx TLS proxy
After=network.target rctl-relay.service
Requires=rctl-relay.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/rctl-relay-nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/rctl-relay-nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -s reload -c /etc/nginx/rctl-relay-nginx.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
