# Copy to .env on the VPS. Never commit .env.

# Bind inside the container. docker-compose publishes this behind Caddy/Nginx.
RCTL_RELAY_LISTEN=:8080

# Public HTTPS origin. Device WebSocket endpoint becomes:
#   wss://your-domain.example/device
RCTL_RELAY_PUBLIC_URL=https://your-domain.example

# Persisted SQLite database path inside the container.
RCTL_RELAY_DB=/data/rctl-relay.db

# Generate with:
#   openssl rand -base64 48
RCTL_RELAY_ADMIN_SECRET=replace-with-long-random-admin-secret
RCTL_RELAY_SESSION_SECRET=replace-with-long-random-session-secret

# Enrollment tokens are short-lived by design.
RCTL_RELAY_ENROLL_TTL=30m

# Application-level rate limits. Keep reverse-proxy/firewall limits too.
RCTL_RELAY_LOGIN_MAX=5
RCTL_RELAY_LOGIN_WINDOW=1m
RCTL_RELAY_ADMIN_MAX=60
RCTL_RELAY_ADMIN_WINDOW=1m
RCTL_RELAY_DEVICE_MAX=20
RCTL_RELAY_DEVICE_WINDOW=1m
RCTL_RELAY_TUNNEL_MAX=240
RCTL_RELAY_TUNNEL_WINDOW=1m
RCTL_RELAY_TUNNEL_TIMEOUT=20s
RCTL_RELAY_TUNNEL_MAX_BODY=2097152
RCTL_RELAY_STREAM_START_TIMEOUT=20s

# Production must stay 0. Set to 1 only for localhost testing without HTTPS.
RCTL_RELAY_ALLOW_INSECURE=0
