# Copy to /etc/rctl-relay/relay.env on a VPS. Never commit real values.

RCTL_RELAY_LISTEN=127.0.0.1:18080
RCTL_RELAY_PUBLIC_URL=https://rctl.example.com
RCTL_RELAY_DB=/var/lib/rctl-relay/rctl-relay.db
RCTL_RELAY_WEB_DIR=/opt/rctl-relay/web

# Generate both with:
#   openssl rand -base64 48
RCTL_RELAY_ADMIN_SECRET=replace-with-long-random-admin-secret
RCTL_RELAY_SESSION_SECRET=replace-with-long-random-session-secret

RCTL_RELAY_ENROLL_TTL=30m
RCTL_RELAY_TRUST_PROXY_HEADERS=1
RCTL_RELAY_LOGIN_MAX=5
RCTL_RELAY_LOGIN_WINDOW=1m
RCTL_RELAY_ADMIN_MAX=60
RCTL_RELAY_ADMIN_WINDOW=1m
RCTL_RELAY_DEVICE_MAX=20
RCTL_RELAY_DEVICE_WINDOW=1m
RCTL_RELAY_TUNNEL_MAX=240
RCTL_RELAY_TUNNEL_WINDOW=1m
RCTL_RELAY_TUNNEL_TIMEOUT=20s
RCTL_RELAY_TUNNEL_MAX_BODY=2097152
RCTL_RELAY_STREAM_START_TIMEOUT=20s
RCTL_RELAY_ALLOW_INSECURE=0
# WebRTC signaling relay; off until the device/browser WebRTC paths land.
RCTL_RELAY_ENABLE_WEBRTC=0

# STUN/TURN for NAT traversal (coturn). Without these, WebRTC connects only when
# the browser and device share a direct path (same LAN). The relay mints
# short-lived TURN credentials from the shared secret (coturn use-auth-secret /
# the "TURN REST API") and hands the ICE server list to both ends via signaling.
# The secret here MUST equal coturn's `static-auth-secret` (openssl rand -hex 32).
RCTL_RELAY_TURN_SECRET=
RCTL_RELAY_TURN_URLS=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp,turns:relay.example.com:5349?transport=tcp
RCTL_RELAY_STUN_URLS=stun:relay.example.com:3478
RCTL_RELAY_TURN_TTL=1h
