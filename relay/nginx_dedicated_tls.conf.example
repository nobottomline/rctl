# Dedicated Nginx config for running rctl relay side-by-side with another
# service that already owns ports 80/443.
#
# Example:
#   relay listens on 127.0.0.1:18080
#   public URL is https://rctl.example.com:9443
#
# Start with:
#   nginx -t -c /etc/nginx/rctl-relay-nginx.conf
#   nginx -c /etc/nginx/rctl-relay-nginx.conf -g 'daemon off;'

worker_processes 1;
pid /run/rctl-relay-nginx.pid;
error_log /var/log/nginx/rctl-relay-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/rctl-relay-access.log;
    sendfile on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    limit_req_zone $binary_remote_addr zone=rctl_dedicated_login:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=rctl_dedicated_admin:10m rate=60r/m;

    server {
        listen 9443 ssl http2;
        server_name rctl.example.com;

        ssl_certificate /etc/letsencrypt/live/rctl.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/rctl.example.com/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        client_max_body_size 8m;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;

        location = /api/admin/login {
            limit_req zone=rctl_dedicated_login burst=5 nodelay;
            proxy_pass http://127.0.0.1:18080;
            include /etc/nginx/rctl_proxy_params;
        }

        location /api/admin/ {
            limit_req zone=rctl_dedicated_admin burst=60 nodelay;
            proxy_pass http://127.0.0.1:18080;
            include /etc/nginx/rctl_proxy_params;
        }

        location / {
            proxy_pass http://127.0.0.1:18080;
            include /etc/nginx/rctl_proxy_params;
        }
    }
}
