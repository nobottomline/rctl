# Copy to relay.env and edit locally. relay.env is ignored by git.
#
# The relay admin panel should generate ENROLL_TOKEN for this user/device.
# Use a real domain with TLS; device relay URLs must use wss://.

RELAY_URL=wss://rctl.example.com/device
ENROLL_TOKEN=replace-with-at-least-32-random-characters
DEVICE_NAME=iPad Air 3

# Optional. Defaults to ./personalized.
# OUT_DIR=personalized
